# 配備の設定。scripts/editor-deploy/deploy.env にコピーして実際の値を入れる（git は無視する）。
# deploy.env はコミットしない: このリポジトリは公開で、これらの値は本番プロジェクトを特定する。
# 値はすべて例。

GCP_PROJECT=my-gcp-project
GCP_REGION=asia-northeast1
# 同じプロジェクトにある既存の Cloud SQL（PostgreSQL）。この中にデータベース niho_editor を作る。
CLOUDSQL_INSTANCE=my-sql-instance
# Direct VPC egress（Cloud SQL は private IP だけ）。
VPC_NETWORK=default
VPC_SUBNET=default

# 資源の名前（docs/ops/editor-deploy.md §1 の既定）。
ARTIFACT_REPO=niho-editor
SERVICE=niho-editor
MIGRATE_JOB=niho-editor-migrate
RUNNER_SA=niho-editor-runner
MIGRATE_SA=niho-editor-migrate
# バケット名は全体で一意: プロジェクト名を前に付ける。
ASSETS_BUCKET=my-gcp-project-editor-assets

# 画面の独自ドメイン（docs/ops/editor-deploy.md §6）。空なら run.app の URL。
APP_DOMAIN=editor.example.com
# 公開 API の独自ドメイン。空なら API 用の Cloud Run domain mapping は作らない。
# 画面と同じ Cloud Run サービスへ割り当てる。EDITOR_ORIGIN とログイン callback は APP_DOMAIN のまま。
PUBLIC_API_DOMAIN=

# ログイン（#47、docs/ops/editor-deploy.md §13）。既定 niho。google は一時的なサインイン＋許可リスト。stub はここでは使えない。
EDITOR_AUTH_MODE=niho
# niho のときだけ要る専用接続先。path/query/fragment/credentialsなしのexact HTTPS origin。
# 実値はcommitせず、手元のdeploy.envだけに置く。
EDITOR_NIHO_ORIGIN=https://niho-auth.example.invalid
# Firebase Web API key for server-side custom-token exchange. This is public web configuration, not a private credential.
# Put the deployment value only in the ignored deploy.env file; do not commit the real value.
EDITOR_NIHO_FIREBASE_API_KEY=synthetic-firebase-web-api-key-000000000000000000
# EDITOR_AUTH_MODE=google のときだけ要る。OAuth クライアント ID（公開されてよい値）。
# client secret はここに書かない（Secret に set-google-oauth-secret.sh で入れる）。
GOOGLE_OAUTH_CLIENT_ID=000000000000-synthetic.apps.googleusercontent.com
# 入れる人のアドレス（コンマ区切り。小文字に正規化して完全一致。部分一致・ドメイン一致では通らない）。
# 空だと配備を止める（誰も入れない設定のまま動かさないため）。下は例で、実際のアドレスは手元の deploy.env だけに書く。
GOOGLE_ALLOWED_EMAILS=you@example.com,you@gmail.com

# AI（#38、docs/ops/editor-deploy.md §10）。任意。鍵はここに書かない（Secret に set-ai-key.sh で入れる）。
# Secret に有効な版が無ければ、これらは使われず AI は 503 のまま。
# モデル（既定 claude-sonnet-5-5）と、1 人・1 か月の上限（見込みの USD。既定 10）。
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_LIMIT_USD=10
# 文字起こし（#36、docs/ops/editor-deploy.md §12）。任意。鍵はここに書かない（Secret に set-transcribe-key.sh で入れる）。
# Secret に有効な版が無ければエンジンはオフ（VTT の取り込みは鍵なしで動く）。空ならアプリの既定（1200 秒）。
TRANSCRIBE_TIMEOUT_SEC=
# 別のエンジンの案（#36 段 3b-4）。任意。鍵はここに書かない（Secret に set-gemini-key.sh で入れる）。
# Secret に有効な版が無ければ Gemini の案は作れない（既定のエンジンは上の deepgram のまま）。
# 空ならアプリの既定のモデル（gemini-3.8-flash）。
GEMINI_MODEL=
# 音声から起こすには、鍵のほかに呼び出し口が要る（1 回の要求に収まらないため）。空ならオフ（開始は 503）。
# cloud-tasks にすると、Cloud Tasks に積み、同じサービスの worker の route（OIDC で守る）が実行する。
# 先に gcp-bootstrap.sh resources（transcribe-infra.sh）でキュー・サービスアカウント・掃除の Scheduler を作る。
TRANSCRIBE_MODE=
# 手順（#37）の実行基盤（docs/ops/editor-deploy.md §11）。空ならオフ（手順の開始は 503）。
# cloud-tasks にすると、Cloud Tasks に積み、同じサービスの worker の route（OIDC で守る）が実行する。
# 先に gcp-bootstrap.sh resources（steps-infra.sh）でキュー・サービスアカウント・掃除の Scheduler を作る。
STEPS_MODE=
# task と掃除の OIDC トークンの身元（どの資源の権限も持たない）。既定 niho-editor-tasks。
TASKS_SA=niho-editor-tasks
# Experience article authority. Server-only placeholder values.
EDITOR_EXPERIENCE_ARTICLE_AUTHORITY_ENABLED=false
# EDITOR_EXPERIENCE_ORIGIN=https://experience.example.invalid
# EDITOR_EXPERIENCE_ARTICLE_AUTHORITY_AUDIENCE=https://experience-service.example.invalid
EDITOR_ARTICLE_AUTHORITY_API_ENABLED=false
# EDITOR_ARTICLE_AUTHORITY_AUDIENCE=https://editor-service.example.invalid
# EDITOR_ARTICLE_AUTHORITY_SERVICE_ACCOUNT_EMAILS=experience@example-project.iam.gserviceaccount.com
# 公開API用の検証情報（SHA-256・audience・期限のJSON）を持つ、owner作成済みSecretの固定版。
# 生tokenをこのファイルへ書かない。runtime IDにそのSecretの読取権限を別途設定する。
EDITOR_FACE_CREDENTIALS_SECRET_REF=
# 公開写真を配信するexact HTTPS origin。空ならExperience連携を開く際に画面originを使う。
EDITOR_ASSET_ORIGIN=

# 一時的な翻訳候補/書き出しsnapshotの暗号化keyring。ownerがSecretへ投入した固定数値版だけ。
# 本文/鍵の値はこのファイルへ書かない。空なら該当する新規処理は閉じたまま。
# runtime IDだけに当該Secretの読取権限を設定し、24h以内の旧jobがある間は旧keyもkeyringへ残す。
EDITOR_PRIVATE_JOBS_KEY_RING_SECRET_REF=
