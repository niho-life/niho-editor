{
  "description": "Synthetic negative cases. Each applies one change to destinations/<base>.json; the whole declaration must be rejected with the expected issue.",
  "cases": [
    {
      "name": "unknown condition kind",
      "base": "exp",
      "path": [
        "requires",
        0,
        "kind"
      ],
      "value": "langs",
      "expect": {
        "path": "$.requires[0].kind",
        "reason": "unknown-kind"
      }
    },
    {
      "name": "kind is case-sensitive",
      "base": "exp",
      "path": [
        "requires",
        5,
        "kind"
      ],
      "value": "NoConfirm",
      "expect": {
        "path": "$.requires[5].kind",
        "reason": "unknown-kind"
      }
    },
    {
      "name": "unknown top-level field",
      "base": "exp",
      "path": [
        "theme"
      ],
      "value": "dark",
      "expect": {
        "path": "$.theme",
        "reason": "unknown-field"
      }
    },
    {
      "name": "unknown condition field",
      "base": "exp",
      "path": [
        "requires",
        0,
        "hint"
      ],
      "value": "x",
      "expect": {
        "path": "$.requires[0].hint",
        "reason": "unknown-field"
      }
    },
    {
      "name": "argument of another kind",
      "base": "exp",
      "path": [
        "requires",
        0,
        "min"
      ],
      "value": 1,
      "expect": {
        "path": "$.requires[0].min",
        "reason": "unknown-field"
      }
    },
    {
      "name": "unknown accepts field",
      "base": "exp",
