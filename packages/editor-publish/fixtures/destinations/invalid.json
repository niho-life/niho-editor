  "documents": [
    {
      "name": "not JSON",
      "text": "{\"schemaVersion\": 1,",
      "expect": {
        "path": "$",
        "reason": "not-json"
      }
    },
    {
      "name": "JSON array",
      "text": "[]",
      "expect": {
        "path": "$",
        "reason": "type"
      }
    },
    {
      "name": "JSON null",
      "text": "null",
      "expect": {
        "path": "$",
        "reason": "type"
      }
    },
    {
      "name": "JSON string",
      "text": "\"exp\"",
      "expect": {
        "path": "$",
        "reason": "type"
      }
    }
  ]
}
