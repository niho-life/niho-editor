{
  "description": "Validator negatives. Each case applies patches to a positive fixture (doc: published-doc.json, index: published-index.json, preview: preview-doc.json, gone / error: gone-moved.json). Expected results live in v1/cases.json.",
  "cases": [
    { "id": "doc-valid", "target": "doc", "patches": [] },
    { "id": "doc-top-level-unknown-field-ignored", "target": "doc", "patches": [{ "op": "set", "path": ["futureField"], "value": { "any": "thing" } }] },
    { "id": "ast-unknown-block", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "type"], "value": "embed" }] },
    { "id": "ast-html-block", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0], "value": { "type": "html", "value": "<p>hi</p>" } }] },
    { "id": "ast-unknown-inline", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 0], "value": { "type": "html", "text": "<b>x</b>" } }] },
    { "id": "ast-unknown-mark", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 1, "marks", 0], "value": { "type": "underline" } }] },
    { "id": "ast-duplicate-mark", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 1, "marks"], "value": [{ "type": "bold" }, { "type": "bold" }] }] },
    { "id": "ast-unknown-block-field", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "html"], "value": "<p>x</p>" }] },
    { "id": "ast-heading-level-1", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 1, "level"], "value": 1 }] },
    { "id": "ast-heading-level-4", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 1, "level"], "value": 4 }] },
    { "id": "ast-nested-list-item", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 3, "items", 0], "value": { "type": "list", "ordered": false, "items": [[{ "type": "text", "text": "Inner" }]] } }] },
    { "id": "ast-nested-list-inline", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 3, "items", 0, 0], "value": { "type": "list", "ordered": false, "items": [[{ "type": "text", "text": "Inner" }]] } }] },
    { "id": "ast-note-heading", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 9, "blocks", 0], "value": { "type": "heading", "level": 2, "content": [{ "type": "text", "text": "Inside" }] } }] },
    { "id": "ast-note-nested-note", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 9, "blocks", 0], "value": { "type": "note", "blocks": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Inside" }] }] } }] },
    { "id": "ast-note-figure", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 9, "blocks", 0], "value": { "type": "figure", "assetId": "asset-figure-01", "caption": null } }] },
    { "id": "ast-empty-paragraph", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content"], "value": [] }] },
    { "id": "ast-blank-heading", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 1, "content"], "value": [{ "type": "text", "text": "   " }] }] },
    { "id": "ast-empty-text", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 0, "text"], "value": "" }] },
    { "id": "ast-control-character", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 0, "text"], "value": "line\nbreak " }] },
    { "id": "ast-figure-missing-asset", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 4, "assetId"], "value": "asset-missing" }] },
    { "id": "ast-unreferenced-asset", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 1], "value": { "id": "asset-unused", "url": "https://assets.example.com/a/unused.jpg", "contentType": "image/jpeg", "bytes": 1024, "sha256": "1111111111111111111111111111111111111111111111111111111111111111", "alt": "Unused", "credit": null } }] },
    { "id": "ast-recording-asset", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 1], "value": { "id": "asset-recording-01", "url": "https://assets.example.com/a/recording-01.m4a", "contentType": "audio/mp4", "bytes": 5242880, "sha256": "2222222222222222222222222222222222222222222222222222222222222222", "alt": "", "credit": null } }] },
    { "id": "ast-svg-asset", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 1], "value": { "id": "asset-vector-01", "url": "https://assets.example.com/a/vector-01.svg", "contentType": "image/svg+xml", "bytes": 2048, "sha256": "3333333333333333333333333333333333333333333333333333333333333333", "alt": "Vector", "credit": null } }] },
    { "id": "ast-duplicate-asset", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 1], "value": { "id": "asset-figure-01", "url": "https://assets.example.com/a/other.jpg", "contentType": "image/jpeg", "bytes": 1024, "sha256": "4444444444444444444444444444444444444444444444444444444444444444", "alt": "Other", "credit": null } }] },
    { "id": "link-javascript", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "javascript:alert(1)" }] },
    { "id": "link-javascript-mixed-case", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "JaVaScRiPt:alert(1)" }] },
    { "id": "link-javascript-leading-space", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": " javascript:alert(1)" }] },
    { "id": "link-vbscript", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "vbscript:msgbox(1)" }] },
    { "id": "link-http", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "http://example.com/" }] },
    { "id": "link-mailto", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "mailto:someone@example.com" }] },
    { "id": "link-data", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "data:text/html;base64,PHA+aGk8L3A+" }] },
    { "id": "link-protocol-relative", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "//evil.example.com/" }] },
    { "id": "link-backslash", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "/\\evil.example.com/" }] },
    { "id": "link-userinfo", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "https://user@example.com/" }] },
    { "id": "link-relative-path", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "maps/harbor" }] },
    { "id": "link-fragment-only", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "#top" }] },
    { "id": "link-entity", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "/&#47;evil.example.com/" }] },
    { "id": "link-quote", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "https://example.com/\"onmouseover=x" }] },
    { "id": "link-whitespace", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "https://example.com/a b" }] },
    { "id": "link-non-ascii", "target": "doc", "patches": [{ "op": "set", "path": ["blocks", 0, "content", 3, "marks", 0, "href"], "value": "https://例え.example.com/" }] },
    { "id": "image-http-asset-url", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 0, "url"], "value": "http://assets.example.com/a/harbor.jpg" }] },
    { "id": "image-site-path-asset-url", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 0, "url"], "value": "/a/harbor.jpg" }] },
    { "id": "image-data-asset-url", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 0, "url"], "value": "data:image/png;base64,iVBORw0KGgo=" }] },
    { "id": "cover-http-url", "target": "doc", "patches": [{ "op": "set", "path": ["cover", "url"], "value": "http://assets.example.com/a/cover-01.jpg" }] },
    { "id": "cover-recording", "target": "doc", "patches": [{ "op": "set", "path": ["cover", "contentType"], "value": "audio/mpeg" }] },
    { "id": "canonical-url-http", "target": "doc", "patches": [{ "op": "set", "path": ["canonicalUrl"], "value": "http://exp.example.com/guides/morning-walk-along-the-coast" }] },
    { "id": "author-url-javascript", "target": "doc", "patches": [{ "op": "set", "path": ["author", "url"], "value": "javascript:alert(1)" }] },
    { "id": "doc-invalid-dest", "target": "doc", "patches": [{ "op": "set", "path": ["dest"], "value": "blog" }] },
    { "id": "doc-invalid-id", "target": "doc", "patches": [{ "op": "set", "path": ["id"], "value": "not-a-uuid" }] },
    { "id": "doc-uppercase-id", "target": "doc", "patches": [{ "op": "set", "path": ["id"], "value": "4F1C2B3A-5D6E-4F70-8A91-B2C3D4E5F607" }] },
    { "id": "doc-invalid-slug", "target": "doc", "patches": [{ "op": "set", "path": ["slug"], "value": "Morning_Walk" }] },
    { "id": "doc-invalid-timestamp", "target": "doc", "patches": [{ "op": "set", "path": ["updatedAt"], "value": "2026-09-15 08:30:00" }] },
    { "id": "doc-timestamp-offset", "target": "doc", "patches": [{ "op": "set", "path": ["updatedAt"], "value": "2026-09-15T17:30:00+09:00" }] },
    { "id": "doc-impossible-date", "target": "doc", "patches": [{ "op": "set", "path": ["updatedAt"], "value": "2026-02-30T00:00:00Z" }] },
    { "id": "doc-updated-before-published", "target": "doc", "patches": [{ "op": "set", "path": ["updatedAt"], "value": "2026-08-01T00:00:00.000Z" }] },
    { "id": "doc-invalid-sha256", "target": "doc", "patches": [{ "op": "set", "path": ["assets", 0, "sha256"], "value": "XYZ" }] },
    { "id": "doc-invalid-lang", "target": "doc", "patches": [{ "op": "set", "path": ["lang"], "value": "fr" }] },
    { "id": "doc-invalid-range", "target": "doc", "patches": [{ "op": "set", "path": ["range"], "value": "private" }] },
    { "id": "doc-site-unlisted", "target": "doc", "patches": [{ "op": "set", "path": ["dest"], "value": "site" }, { "op": "set", "path": ["range"], "value": "unlisted" }] },
    { "id": "doc-contract-version", "target": "doc", "patches": [{ "op": "set", "path": ["contractVersion"], "value": "2" }] },
    { "id": "doc-version-zero", "target": "doc", "patches": [{ "op": "set", "path": ["version"], "value": 0 }] },
    { "id": "doc-related-duplicate", "target": "doc", "patches": [{ "op": "set", "path": ["related"], "value": ["sunrise-yoga", "sunrise-yoga"] }] },
    { "id": "doc-nested-unknown-field", "target": "doc", "patches": [{ "op": "set", "path": ["extras", "ads"], "value": true }] },
    { "id": "doc-missing-title", "target": "doc", "patches": [{ "op": "remove", "path": ["title"] }] },
    { "id": "doc-cover-shareable-valid", "target": "doc", "patches": [{ "op": "set", "path": ["coverShareable"], "value": true }] },
    { "id": "doc-cover-shareable-false", "target": "doc", "patches": [{ "op": "set", "path": ["coverShareable"], "value": false }] },
    { "id": "doc-cover-shareable-string", "target": "doc", "patches": [{ "op": "set", "path": ["coverShareable"], "value": "true" }] },
    { "id": "doc-cover-shareable-without-cover", "target": "doc", "patches": [{ "op": "set", "path": ["cover"], "value": null }, { "op": "set", "path": ["coverShareable"], "value": true }] },
    { "id": "doc-cover-shareable-inside-cover", "target": "doc", "patches": [{ "op": "set", "path": ["cover", "shareable"], "value": true }] },
    { "id": "doc-author-profile-valid", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": "Coastal walk guide", "bio": null } }] },
    { "id": "doc-author-profile-unknown-field", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": "Coastal walk guide", "bio": null, "avatar": "https://writer.example.com/a.jpg" } }] },
    { "id": "doc-author-profile-missing-bio", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": "Coastal walk guide" } }] },
    { "id": "doc-author-profile-both-null", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": null, "bio": null } }] },
    { "id": "doc-author-profile-blank-role", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": "   ", "bio": "Writes about mornings by the sea." } }] },
    { "id": "doc-author-profile-bio-control-character", "target": "doc", "patches": [{ "op": "set", "path": ["authorProfile"], "value": { "role": null, "bio": "First line\nSecond line" } }] },
    { "id": "doc-author-profile-inside-author", "target": "doc", "patches": [{ "op": "set", "path": ["author", "role"], "value": "Coastal walk guide" }] },
    { "id": "doc-markdown-mismatch", "target": "doc", "patches": [{ "op": "set", "path": ["markdown"], "value": "## Something else\n" }] },
    { "id": "doc-markdown-html", "target": "doc", "patches": [{ "op": "set", "path": ["markdown"], "value": "<script>alert(1)</script>\n" }] },
    { "id": "index-valid", "target": "index", "patches": [] },
    { "id": "index-item-unknown-field-ignored", "target": "index", "patches": [{ "op": "set", "path": ["items", 0, "futureField"], "value": 1 }] },
    { "id": "index-mixed-dest", "target": "index", "patches": [{ "op": "set", "path": ["items", 1, "dest"], "value": "exp" }] },
    { "id": "index-out-of-order", "target": "index", "patches": [{ "op": "set", "path": ["items", 0, "updatedAt"], "value": "2026-09-01T00:00:00.000Z" }] },
    { "id": "index-same-time-id-order", "target": "index", "patches": [{ "op": "set", "path": ["items", 2, "id"], "value": "0a0b0c0d-0e0f-4a1b-8c2d-3e4f5a6b7c8d" }] },
    { "id": "index-duplicate-id", "target": "index", "patches": [{ "op": "set", "path": ["items", 2, "id"], "value": "1a2b3c4d-5e6f-4071-8293-a4b5c6d7e8f9" }] },
    { "id": "index-site-unlisted", "target": "index", "patches": [{ "op": "set", "path": ["items", 0, "range"], "value": "unlisted" }] },
    { "id": "index-bad-cursor", "target": "index", "patches": [{ "op": "set", "path": ["nextCursor"], "value": "has space" }] },
    { "id": "index-contract-version", "target": "index", "patches": [{ "op": "remove", "path": ["contractVersion"] }] },
    { "id": "index-item-optional-fields-valid", "target": "index", "patches": [{ "op": "set", "path": ["items", 0, "coverShareable"], "value": true }, { "op": "set", "path": ["items", 0, "authorProfile"], "value": { "role": null, "bio": "Writes about mornings by the sea." } }] },
    { "id": "index-item-cover-shareable-without-cover", "target": "index", "patches": [{ "op": "set", "path": ["items", 1, "coverShareable"], "value": true }] },
    { "id": "preview-valid", "target": "preview", "patches": [] },
    { "id": "preview-noindex-false", "target": "preview", "patches": [{ "op": "set", "path": ["preview", "noindex"], "value": false }] },
    { "id": "preview-dest-mismatch", "target": "preview", "patches": [{ "op": "set", "path": ["preview", "dest"], "value": "exp" }] },
    { "id": "preview-missing", "target": "preview", "patches": [{ "op": "remove", "path": ["preview"] }] },
    { "id": "gone-body-valid", "target": "gone", "options": { "from": "exp" }, "patches": [] },
    { "id": "gone-body-without-moved-to", "target": "gone", "patches": [{ "op": "remove", "path": ["movedTo"] }] },
    { "id": "gone-moved-to-site", "target": "gone", "patches": [{ "op": "set", "path": ["movedTo", "dest"], "value": "site" }] },
    { "id": "gone-moved-to-http", "target": "gone", "patches": [{ "op": "set", "path": ["movedTo", "canonicalUrl"], "value": "http://niho.example.com/article/moved-between-faces" }] },
    { "id": "gone-moved-to-same-face", "target": "gone", "options": { "from": "niho" }, "patches": [] },
    { "id": "gone-moved-to-extra-field", "target": "gone", "patches": [{ "op": "set", "path": ["movedTo", "pageId"], "value": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d" }] },
    { "id": "error-moved-to-on-not-found", "target": "error", "patches": [{ "op": "set", "path": ["error", "code"], "value": "not_found" }] }
  ]
}
