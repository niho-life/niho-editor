{
  "contractVersion": "1",
  "description": "Synthetic scenarios for docs/security/editor-publish-api-v1.md. layer=server runs against the reference model (and should pass against the private server); validator and markdown run against the public validators. Inputs are built at run time or live in fixtures/.",
  "cases": [
    {"id": "list-excludes-draft", "layer": "server", "mutation": "list own handle; target page was never published", "expected": {"status": 200, "listed": false}},
    {"id": "get-draft-not-found", "layer": "server", "mutation": "get a never-published page by id", "expected": {"status": 404, "code": "not_found"}},
    {"id": "list-excludes-private", "layer": "server", "mutation": "list own handle; target page is private (only me)", "expected": {"status": 200, "listed": false}},
    {"id": "get-private-not-found", "layer": "server", "mutation": "get a private page by id", "expected": {"status": 404, "code": "not_found"}},
    {"id": "list-excludes-stopped", "layer": "server", "mutation": "list own handle; target page was unpublished", "expected": {"status": 200, "listed": false}},
    {"id": "get-stopped-gone", "layer": "server", "mutation": "get an unpublished page with a credential for its handle", "expected": {"status": 410, "code": "gone", "movedTo": null}},
    {"id": "get-stopped-foreign-credential-not-found", "layer": "server", "mutation": "get an unpublished page with another connection's key", "expected": {"status": 404, "code": "not_found"}},
    {"id": "get-missing-not-found", "layer": "server", "mutation": "get an id that does not exist", "expected": {"status": 404, "code": "not_found"}},
    {"id": "get-other-dest-not-found", "layer": "server", "mutation": "get a page published to exp through a site handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "get-other-connection-page-not-found", "layer": "server", "mutation": "get another connection's page through own handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "get-foreign-handle-not-found", "layer": "server", "mutation": "site key reads another connection's handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "list-foreign-handle-not-found", "layer": "server", "mutation": "site key lists another connection's handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "list-invalid-handle-not-found", "layer": "server", "mutation": "list a handle that does not match the handle pattern", "expected": {"status": 404, "code": "not_found"}},
    {"id": "list-reserved-handle-not-found", "layer": "server", "mutation": "site key lists a reserved handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "snapshot-with-recording-fails-closed", "layer": "server", "mutation": "stored snapshot carries a recording asset; server must not serve it", "expected": {"status": 503, "code": "temporarily_unavailable"}},
    {"id": "revoked-key-unauthenticated", "layer": "server", "mutation": "read with a revoked connection key", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "rotated-key-unauthenticated", "layer": "server", "mutation": "read with the key that was replaced by reissue", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "removed-connection-unauthenticated", "layer": "server", "mutation": "read with the key of a removed connection", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "unknown-key-unauthenticated", "layer": "server", "mutation": "read with a well-formed key that was never issued", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "other-connection-key-not-found", "layer": "server", "mutation": "read own page with a valid key of another connection", "expected": {"status": 404, "code": "not_found"}},
    {"id": "other-face-token-not-found", "layer": "server", "mutation": "exp token lists the niho handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "other-face-token-doc-not-found", "layer": "server", "mutation": "exp token reads a niho page", "expected": {"status": 404, "code": "not_found"}},
    {"id": "face-token-on-site-handle-not-found", "layer": "server", "mutation": "exp token lists a site handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "site-key-on-face-handle-not-found", "layer": "server", "mutation": "site key lists the exp handle", "expected": {"status": 404, "code": "not_found"}},
    {"id": "missing-authorization-unauthenticated", "layer": "server", "mutation": "no Authorization header", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "non-bearer-authorization-unauthenticated", "layer": "server", "mutation": "Authorization uses the Basic scheme", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "multiple-authorization-unauthenticated", "layer": "server", "mutation": "two Authorization header values", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "expired-face-token-unauthenticated", "layer": "server", "mutation": "face token past its expiry", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "revoked-face-token-unauthenticated", "layer": "server", "mutation": "face token revoked", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "revoked-key-if-none-match-unauthenticated", "layer": "server", "mutation": "revoked key sends the current list ETag", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "rotated-key-if-none-match-unauthenticated", "layer": "server", "mutation": "replaced key sends the current doc ETag", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "expired-face-token-if-none-match-unauthenticated", "layer": "server", "mutation": "expired face token sends the current list ETag", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "foreign-handle-if-none-match-not-found", "layer": "server", "mutation": "another connection's key sends the list ETag of a handle it cannot read", "expected": {"status": 404, "code": "not_found"}},
    {"id": "if-none-match-not-modified", "layer": "server", "mutation": "valid key sends the current doc ETag", "expected": {"status": 304, "body": false, "etag": true}},
    {"id": "if-none-match-star-not-modified", "layer": "server", "mutation": "valid key sends If-None-Match: *", "expected": {"status": 304}},
    {"id": "if-none-match-weak-list-not-modified", "layer": "server", "mutation": "valid key sends a list of tags with the current one W/-prefixed", "expected": {"status": 304}},
    {"id": "if-none-match-stale-ok", "layer": "server", "mutation": "valid key sends an old ETag", "expected": {"status": 200}},
    {"id": "list-excludes-other-dest", "layer": "server", "mutation": "site list never mixes in exp publications", "expected": {"status": 200, "listed": false}},
    {"id": "list-excludes-other-connection", "layer": "server", "mutation": "site list never mixes in another connection's publications", "expected": {"status": 200, "listed": false}},
    {"id": "face-list-excludes-other-face", "layer": "server", "mutation": "exp list never mixes in niho publications", "expected": {"status": 200, "listed": false}},
    {"id": "list-excludes-unlisted-by-default", "layer": "server", "mutation": "face list without include omits unlisted", "expected": {"status": 200, "listed": false}},
    {"id": "list-includes-unlisted-for-face", "layer": "server", "mutation": "face list with include=unlisted lists unlisted", "expected": {"status": 200, "listed": true}},
    {"id": "site-include-unlisted-invalid", "layer": "server", "mutation": "site key passes include=unlisted", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "get-unlisted-face-ok", "layer": "server", "mutation": "face reads an unlisted page of its own handle", "expected": {"status": 200}},
    {"id": "include-unknown-invalid", "layer": "server", "mutation": "include has an unknown value", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "include-duplicate-invalid", "layer": "server", "mutation": "include is given twice", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "limit-zero-invalid", "layer": "server", "mutation": "limit=0", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "limit-over-max-invalid", "layer": "server", "mutation": "limit=101", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "limit-non-numeric-invalid", "layer": "server", "mutation": "limit is not a number", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "limit-leading-zero-invalid", "layer": "server", "mutation": "limit has a leading zero", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "cursor-malformed-invalid", "layer": "server", "mutation": "cursor was not issued by the server", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "cursor-empty-invalid", "layer": "server", "mutation": "cursor is empty", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "unknown-query-invalid", "layer": "server", "mutation": "unknown query parameter", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "list-order-and-pagination", "layer": "server", "mutation": "walk the list with limit=2; order is updatedAt desc then id asc, no gaps or repeats", "expected": {"status": 200, "ordered": true, "pages": 5}},
    {"id": "list-default-limit", "layer": "server", "mutation": "55 publications without limit", "expected": {"status": 200, "count": 50, "hasNext": true}},
    {"id": "published-ignores-draft-edits", "layer": "server", "mutation": "edit the draft after publishing, then get the page", "expected": {"status": 200, "source": "snapshot"}},
    {"id": "list-ignores-draft-edits", "layer": "server", "mutation": "edit the draft after publishing, then list", "expected": {"status": 200, "source": "snapshot"}},
    {"id": "republish-same-id-and-url", "layer": "server", "mutation": "unpublish then publish again", "expected": {"before": 410, "after": 200, "sameIdAndUrl": true, "listed": true}},
    {"id": "preview-ok", "layer": "server", "mutation": "face reads a preview token bound to its dest", "expected": {"status": 200, "noindex": true, "cacheControl": "no-store", "source": "draft"}},
    {"id": "preview-site-ok", "layer": "server", "mutation": "site key reads a preview token bound to its connection", "expected": {"status": 200}},
    {"id": "preview-expired-not-found", "layer": "server", "mutation": "preview token past its expiry", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-unknown-not-found", "layer": "server", "mutation": "well-formed preview token that was never issued", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-malformed-token-not-found", "layer": "server", "mutation": "preview path segment is not a pv_ token", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-other-face-not-found", "layer": "server", "mutation": "token bound to exp read with a niho credential", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-other-connection-not-found", "layer": "server", "mutation": "token bound to one connection read with another connection's key", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-site-token-face-credential-not-found", "layer": "server", "mutation": "token bound to a site read with a face credential", "expected": {"status": 404, "code": "not_found"}},
    {"id": "preview-without-credential-unauthenticated", "layer": "server", "mutation": "preview token alone, no Authorization", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "preview-revoked-key-unauthenticated", "layer": "server", "mutation": "preview with a revoked key", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "preview-token-as-bearer-unauthenticated", "layer": "server", "mutation": "preview token sent as the Bearer credential of the published list", "expected": {"status": 401, "code": "unauthenticated"}},
    {"id": "preview-token-as-published-id-invalid", "layer": "server", "mutation": "preview token used as the id of the published endpoint", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "preview-follows-edited-draft", "layer": "server", "mutation": "draft is edited after the token was issued; the same token reads the current draft", "expected": {"status": 200, "source": "current-draft"}},
    {"id": "preview-ttl-over-limit-not-found", "layer": "server", "mutation": "token issued with a lifetime over 15 minutes", "expected": {"status": 404, "code": "not_found"}},
    {"id": "gone-moved-face-to-face", "layer": "server", "mutation": "exp page moved to niho, read with the exp credential", "expected": {"status": 410, "code": "gone", "movedTo": {"canonicalUrl": "https://niho.example.com/article/moved-between-faces", "dest": "niho"}}},
    {"id": "gone-face-stopped-no-moved-to", "layer": "server", "mutation": "exp page unpublished, not moved", "expected": {"status": 410, "code": "gone", "movedTo": null}},
    {"id": "gone-moved-face-to-site-no-moved-to", "layer": "server", "mutation": "exp page moved to a site", "expected": {"status": 410, "code": "gone", "movedTo": null}},
    {"id": "gone-moved-site-to-face-no-moved-to", "layer": "server", "mutation": "site page moved to exp, read with the site key", "expected": {"status": 410, "code": "gone", "movedTo": null}},
    {"id": "gone-moved-other-face-not-found", "layer": "server", "mutation": "exp page moved to niho, read on the exp handle with the niho credential", "expected": {"status": 404, "code": "not_found"}},
    {"id": "gone-moved-target-stopped-no-moved-to", "layer": "server", "mutation": "exp page moved to niho and later unpublished there", "expected": {"status": 410, "code": "gone", "movedTo": null}},
    {"id": "moved-target-serves-new-url", "layer": "server", "mutation": "the move target serves the page at its new canonical URL", "expected": {"status": 200, "canonicalUrl": "https://niho.example.com/article/moved-between-faces"}},
    {"id": "get-malformed-id-invalid", "layer": "server", "mutation": "published id is not a UUID", "expected": {"status": 400, "code": "invalid_request"}},
    {"id": "unsupported-method-invalid", "layer": "server", "mutation": "POST to the published list", "expected": {"status": 400, "code": "invalid_request", "allow": "GET, HEAD"}},
    {"id": "unknown-route-not-found", "layer": "server", "mutation": "path outside the three endpoints", "expected": {"status": 404, "code": "not_found"}},
    {"id": "head-matches-get", "layer": "server", "mutation": "HEAD returns the GET headers without a body", "expected": {"status": 200, "body": false, "sameHeaders": true}},
    {"id": "response-headers", "layer": "server", "mutation": "headers of 200, preview 200, 404 and 401", "expected": {"ok": {"contentType": "application/json; charset=utf-8", "robots": "noindex", "cacheControl": "private, no-cache", "vary": "Authorization", "strongEtag": true, "wwwAuthenticate": null}, "preview": {"contentType": "application/json; charset=utf-8", "robots": "noindex", "cacheControl": "no-store", "vary": "Authorization", "strongEtag": true, "wwwAuthenticate": null}, "missing": {"contentType": "application/json; charset=utf-8", "robots": "noindex", "cacheControl": "no-store", "vary": "Authorization", "strongEtag": false, "wwwAuthenticate": null}, "unauthenticated": {"contentType": "application/json; charset=utf-8", "robots": "noindex", "cacheControl": "no-store", "vary": "Authorization", "strongEtag": false, "wwwAuthenticate": "Bearer"}}},
