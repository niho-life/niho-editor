{
  "name": "@niho/docs",
  "version": "0.1.51",
  "private": true,
  "type": "module",
  "description": "NIHO docs（Mac・Tauri 2 ＋ React）。工程を本人が設計できるドキュメント制作アプリ。",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:fake": "NIHO_DOCS_CLAUDE_CLI_PATH=\"$PWD/sidecar/fake/claude\" NIHO_DOCS_CODEX_CLI_PATH=\"$PWD/sidecar/fake/codex\" NIHO_DOCS_AGY_CLI_PATH=\"$PWD/sidecar/fake/agy\" NIHO_DOCS_SPEECH_PATH=\"$PWD/sidecar/fake/niho-speech\" tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "build": "vite build",
    "build:app": "npm run sidecar:build && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "sidecar:build": "node scripts/stage-speech-sidecar.mjs",
    "sidecar:stage-test": "node --test scripts/stage-speech-sidecar.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@niho/docs-core": "file:../../packages/docs-core",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tauri-apps/api": "^2.12.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "1.58.0",
    "markdown-it": "^14.3.2",
    "niho-desktop-account": "file:../../packages/desktop-account/ts",
    "niho-docs-ui": "file:../../packages/docs-ui",
    "niho-ui": "file:../../packages/ui",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-search": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
