{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NIHO editor",
  "version": "0.1.51",
  "identifier": "life.niho.docs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NIHO editor",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 14 },
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#FCFCFB",
        "theme": "Light",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default", "remote-editor"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/account/account-avatar.*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://niho.life/docs/updater/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNDM5M0RCMjI5MDZGMDEKUldRQmI1QWkyNU5EODhNY3JaMDM0Q1NjMTRlaXhjZmxERURNbG5HSGI1WjhRQUwxa1dobEZZazYK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["niho-docs"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "NIHO editor",
    "longDescription": "工程を本人が設計できる、Mac のドキュメント制作アプリ。",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
